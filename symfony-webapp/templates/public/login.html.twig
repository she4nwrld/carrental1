<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Log In — Shift Car Rental</title>
<link rel="icon" type="image/png" href="{{ asset('images/shift-mark.png') }}?v=2">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700;800&amp;family=Inter:wght@400;500;600&amp;display=swap" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="{{ asset('css/style.css') }}">
</head>

<body class="auth-page">

<header class="topbar">
  <div class="brand">
    <a href="{{ path('home') }}">
      <img src="{{ asset('images/shift-logo.png') }}" alt="Shift Car Rental">
    </a>
  </div>
  <div class="right">
    <a href="{{ path('app_register') }}">Need an account?</a>
  </div>
</header>

<main class="auth-main">
  <section class="auth-card">

    <h1>Welcome back</h1>
    <p class="auth-sub">Log in to manage your bookings.</p>

    {% if error %}
      <div class="auth-errors" role="alert">
        <ul>
          <li>{{ 'disabled' in error.messageKey|lower ? error.messageKey : 'Incorrect email or password.' }}</li>
        </ul>
      </div>
    {% endif %}

    <form method="POST" action="{{ path('app_login') }}" class="auth-form" novalidate>

      <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
      {% if next|default('') != '' %}
        <input type="hidden" name="_target_path" value="{{ next }}">
      {% endif %}

      <div class="auth-field">
        <label for="email">Email Address</label>
        <input type="email" id="email" name="username"
               value="{{ last_username }}"
               placeholder="juan@example.com" required autofocus>
      </div>

      <div class="auth-field">
        <label for="password">Password</label>
        <input type="password" id="password" name="password"
               autocomplete="current-password"
               placeholder="Your password" required>
      </div>

      <button type="submit" class="auth-btn">Log In</button>

    </form>

    <p class="auth-alt">No account yet? <a href="{{ path('app_register') }}">Create one</a></p>

  </section>
</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
